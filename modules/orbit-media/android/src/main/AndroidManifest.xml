<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries><package android:name="com.netflix.mediaclient" /></queries>
  <application>
    <service android:name="expo.modules.orbitmedia.OrbitMediaListener"
      android:label="Orbit Netflix controls"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
      <!-- MediaSession access needs an enabled listener, not notification contents. -->
      <meta-data android:name="android.service.notification.default_filter_types" android:value="" />
      <meta-data android:name="android.service.notification.disabled_filter_types" android:value="conversations|alerting|ongoing|silent" />
    </service>
  </application>
</manifest>
